{
    "name": "moonshine/spring",
    "description": "Description",
    "keywords": ["keyword"],
    "type": "library",
    "homepage": "https://moonshine.cutcode.dev",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/moonshine/spring/issues",
        "source": "https://github.com/moonshine/spring"
    },
    "authors": [
        {
            "name": "Author name",
            "email": "author@example.com",
            "homepage": "https://example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "moonshine/moonshine": "4.x-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0",
        "larastan/larastan": "^3.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MoonShine\\Spring\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MoonShine\\Spring\\Tests\\": "tests/",
            "MoonShine\\Spring\\Database\\Factories\\": "database/factories/"
        }
    },
    "conflict": {
        "moonshine/moonshine": "<4.0"
    },
    "scripts": {
        "analyse": "php -d memory_limit=-1 vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "rector": "vendor/bin/rector process --clear-cache"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MoonShine\\Spring\\Providers\\SpringServiceProvider"
            ]
        }
    }
}
