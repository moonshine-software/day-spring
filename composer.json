{
    "name": "moonshine/day-spring",
    "description": "Description",
    "keywords": ["keyword"],
    "type": "library",
    "homepage": "https://moonshine.cutcode.dev",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/moonshine/day-spring/issues",
        "source": "https://github.com/moonshine/day-spring"
    },
    "authors": [
        {
            "name": "Author name",
            "email": "author@example.com",
            "homepage": "https://example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "moonshine/moonshine": "3.0^"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0",
        "rector/rector": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "MoonShine\\DaySpring\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MoonShine\\DaySpring\\Tests\\": "tests/",
            "MoonShine\\DaySpring\\Database\\Factories\\": "database/factories/"
        }
    },
    "conflict": {
        "moonshine/moonshine": "<3.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "rector": "vendor/bin/rector process --clear-cache"
    },
    "extra": {
        "laravel": {
            "providers": [
                "DaySpringServiceProvider"
            ]
        }
    }
}
